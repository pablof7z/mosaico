{
  "name": "pi-mosaico",
  "version": "0.3.0",
  "description": "Mosaico identity, awareness, lifecycle, and optional Pi Panels sidebar integration for Pi",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "pi-package",
    "mosaico",
    "coding-agent"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pablof7z/mosaico.git",
    "directory": "integrations/pi"
  },
  "files": [
    "mosaico.ts",
    "command.ts",
    "daemon.ts",
    "delivery.ts",
    "panel.ts",
    "panel-model.ts",
    "panel-view.ts",
    "protocol.ts",
    "status.ts",
    "tools.ts",
    "README.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./mosaico.ts"
    ]
  },
  "scripts": {
    "test": "node --experimental-strip-types --test test/*.test.mjs test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test && npm pack --dry-run"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.80.4",
    "@earendil-works/pi-tui": ">=0.84.2"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.84.2",
    "@earendil-works/pi-tui": "0.84.2",
    "@types/node": "22.18.3",
    "typescript": "5.9.2"
  }
}
