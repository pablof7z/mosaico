{
  "hooks": {
    "SessionStart": [
      { "hooks": [{ "type": "command", "command": "mosaico harness hook claude-code --type session-start" }] }
    ],
    "SessionEnd": [
      { "hooks": [{ "type": "command", "command": "mosaico harness hook claude-code --type session-end" }] }
    ],
    "UserPromptSubmit": [
      { "hooks": [{ "type": "command", "command": "mosaico harness hook claude-code --type user-prompt-submit" }] }
    ],
    "PreToolUse": [
      {
        "matcher": "Read|Write|Edit|MultiEdit|NotebookEdit|Glob|Grep",
        "hooks": [{ "type": "command", "command": "mosaico harness hook claude-code --type pre-tool-use", "timeout": 5 }]
      }
    ],
    "Stop": [
      { "hooks": [{ "type": "command", "command": "mosaico harness hook claude-code --type stop" }] }
    ]
  }
}
